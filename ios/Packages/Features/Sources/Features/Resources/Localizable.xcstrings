    "agent.empty.vac.employee" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag mich nach deinen Ferien. Ein Gesuch wird erst eingereicht, wenn du auf der Karte bestätigst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask me about your vacation. A request is only submitted when you confirm on the card."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posez-moi vos questions sur vos vacances. Une demande n’est envoyée que lorsque vous confirmez sur la carte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedimi delle tue vacanze. Una richiesta viene inviata solo quando confermi sulla scheda."
          }
        }
      }
    },
    "agent.empty.vac.manager" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich zeige offene Gesuche und die Teamabdeckung. Entschieden wird erst, wenn du auf der Karte bestätigst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I show open requests and team coverage. Nothing is decided until you confirm on the card."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je montre les demandes ouvertes et la couverture de l’équipe. Rien n’est décidé tant que vous ne confirmez pas sur la carte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostro le richieste aperte e la copertura del team. Nulla viene deciso finché non confermi sulla scheda."
          }
        }
      }
