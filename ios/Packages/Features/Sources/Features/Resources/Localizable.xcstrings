          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso in corso …"
          }
        }
      }
    },
    "signin.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut versuchen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
