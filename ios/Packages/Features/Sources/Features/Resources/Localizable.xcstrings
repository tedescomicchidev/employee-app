{
  "sourceLanguage": "en",
  "strings": {
    "signin.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenue"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Benvenuto"
          }
        }
      }
    },
    "signin.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with your work account to continue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich mit deinem Geschäftskonto an, um fortzufahren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec votre compte professionnel pour continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi con il tuo account aziendale per continuare."
          }
        }
      }
    },
    "signin.button": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmelden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se connecter"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi"
          }
        }
      }
    },
    "signin.in_progress": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in …"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldung läuft …"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion en cours …"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso in corso …"
          }
        }
      }
    },
    "signin.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut versuchen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprova"
          }
        }
      }
    },
    "signin.cancelled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in was cancelled."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung wurde abgebrochen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a été annulée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso è stato annullato."
          }
        }
      }
    },
    "signin.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in failed. Please try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung ist fehlgeschlagen. Bitte versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a échoué. Veuillez réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso non riuscito. Riprova."
          }
        }
      }
    },
    "signin.not_allowed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account can’t use the app. Use your work account from the demo tenant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto kann die App nicht verwenden. Verwende dein Geschäftskonto des Demo-Mandanten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte ne peut pas utiliser l’application. Utilisez votre compte professionnel du locataire de démonstration."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo account non può usare l’app. Usa il tuo account aziendale del tenant demo."
          }
        }
      }
    },
    "signin.misconfigured": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is not configured for sign-in yet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App ist noch nicht für die Anmeldung konfiguriert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’application n’est pas encore configurée pour la connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app non è ancora configurata per l’accesso."
          }
        }
      }
    },
    "signin.offline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No connection. Check your network and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Verbindung. Prüfe dein Netzwerk und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de connexion. Vérifiez votre réseau et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna connessione. Controlla la rete e riprova."
          }
        }
      }
    },
