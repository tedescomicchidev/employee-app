    "reauth.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session has expired. Unsent drafts stay on this device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Sitzung ist abgelaufen. Nicht gesendete Entwürfe bleiben auf diesem Gerät erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session a expiré. Les brouillons non envoyés restent sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione è scaduta. Le bozze non inviate restano su questo dispositivo."
          }
        }
