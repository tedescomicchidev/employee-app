    "more.signout.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokens, cached data, notifications and conversations on this device are deleted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Token, zwischengespeicherte Daten, Benachrichtigungen und Unterhaltungen auf diesem Gerät werden gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jetons, les données en cache, les notifications et les conversations sur cet appareil seront supprimés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Token, dati in cache, notifiche e conversazioni su questo dispositivo verranno eliminati."
          }
        }
      }
    },
