    "agent.empty.ann.publisher" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich lese Mitteilungen nach und bereite neue für dich vor. Veröffentlicht wird erst, wenn du auf der Karte bestätigst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I look up announcements and prepare new ones for you. Nothing is published until you confirm on the card."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je consulte les communications et en prépare de nouvelles. Rien n’est publié tant que vous ne confirmez pas sur la carte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulto le comunicazioni e ne preparo di nuove. Nulla viene pubblicato finché non confermi sulla scheda."
          }
        }
      }
    },
    "agent.empty.ann.reader" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag mich nach Mitteilungen. Ich lese sie für dich nach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask me about announcements. I look them up for you."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posez-moi des questions sur les communications. Je les consulte pour vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedimi delle comunicazioni. Le consulto per te."
          }
        }
      }
    },
