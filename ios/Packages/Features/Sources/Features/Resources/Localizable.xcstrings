{
  "sourceLanguage": "en",
  "strings": {
    "signin.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenue"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Benvenuto"
          }
        }
      }
    },
    "signin.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with your work account to continue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich mit deinem Geschäftskonto an, um fortzufahren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec votre compte professionnel pour continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi con il tuo account aziendale per continuare."
          }
        }
      }
    },
    "signin.button": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmelden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se connecter"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi"
          }
        }
      }
    },
    "signin.in_progress": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in …"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldung läuft …"
          }
